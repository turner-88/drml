# Copy to .env and adjust.
ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
APP_URL=http://localhost:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drml
DB_USER=drml
DB_PASSWORD=

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_HOURS=24

# Serve fp32 instead with MODEL_PATH=model/vit_dr.onnx (~330 MB, +0.7 pts accuracy).
MODEL_PATH=model/vit_dr_int8.onnx
# Saliency overlay on the scan detail page. Set false to remove it from the UI.
MODEL_HEATMAP_ENABLED=true
# auto (default): class-specific gradient-weighted attention relevance when the
# graph carries gradients, attention rollout otherwise. rollout: force the
# weaker fallback. grad-relevance: refuse to start on a graph without gradients.
# Forcing rollout does not skip the backward pass; for that, serve a graph from
# `export.py --forward-only`.
MODEL_EXPLAIN_METHOD=auto
# Calibrated thresholds for the non-fundus gate, written by model/gate.py.
# If the file is absent the gate is off and every decodable image is graded.
MODEL_GATE_PATH=model/gate.json

# Auto-detected if unset; set explicitly in containers.
# ORT_LIB_PATH=/usr/local/lib/libonnxruntime.so
ORT_INTRA_OP_THREADS=2
ORT_INTER_OP_THREADS=1
ORT_MAX_QUEUE_DEPTH=4

# Keep the uploaded PDF report alongside the images extracted from it. Off by
# default: a report is ~15 MB against ~1 MB for the images it yields, and the
# images are stored at full resolution either way.
STORAGE_KEEP_SOURCE_PDF=false

STORAGE_DRIVER=local
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
