# Copy to .env and adjust.
ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
APP_URL=http://localhost:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drml
DB_USER=drml
DB_PASSWORD=

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_HOURS=24

# Serve fp32 instead with MODEL_PATH=model/vit_dr.onnx (~330 MB, +0.7 pts accuracy).
MODEL_PATH=model/vit_dr_int8.onnx
# The attention overlay is a weak localizer on the default checkpoint — see
# README "Known limitations". Set false to remove it from the UI.
MODEL_HEATMAP_ENABLED=true

# Auto-detected if unset; set explicitly in containers.
# ORT_LIB_PATH=/usr/local/lib/libonnxruntime.so
ORT_INTRA_OP_THREADS=2
ORT_INTER_OP_THREADS=1
ORT_MAX_QUEUE_DEPTH=4

STORAGE_DRIVER=local
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
