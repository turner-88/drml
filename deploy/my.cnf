# MySQL tuning for a 2 GB VPS shared with the DRML app and its ONNX session.
#
# The app needs ~400-450 MB for the inference arena and ~50 MB for the Go
# runtime, so MySQL must be held to roughly 450 MB. Defaults would claim far
# more — performance_schema alone costs several hundred MB and is the single
# biggest win here.

[mysqld]
performance_schema = OFF

innodb_buffer_pool_size      = 256M
innodb_buffer_pool_instances = 1
innodb_log_buffer_size       = 8M
innodb_flush_method          = O_DIRECT

max_connections = 50

# Per-session buffers are allocated per connection; small values matter once
# max_connections is multiplied in.
sort_buffer_size     = 512K
join_buffer_size     = 512K
read_buffer_size     = 512K
read_rnd_buffer_size = 512K

tmp_table_size       = 16M
max_heap_table_size  = 16M

table_open_cache = 200

character-set-server = utf8mb4
collation-server     = utf8mb4_general_ci
